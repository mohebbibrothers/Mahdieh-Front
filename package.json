{
  "name": "mahdieh-front",
  "version": "0.1.0",
  "private": true,
  "description": "رابط کاربری زائرسرای مهدیه — Next.js (خروجی ایستا) سروشده از جنگو",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "gen": "node scripts/build-tokens.mjs && node scripts/build-icons.mjs && node scripts/gen-api.mjs",
    "gen:check": "node scripts/build-tokens.mjs --check && node scripts/build-icons.mjs --check && node scripts/gen-api.mjs --check",
    "build": "next build && node scripts/postbuild.mjs",
    "serve": "node scripts/serve-static.mjs",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit && node node_modules/typescript-7/bin/tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "pnpm gen:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "bundle": "node scripts/pack-bundle.mjs",
    "bundle:verify": "node scripts/verify-bundle.mjs release/mahdieh-front.tar.gz"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "next": "16.4.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "svgo": "4.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
